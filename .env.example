# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres (Neon). Use the DIRECT connection string for Alembic migrations;
# the pooled (-pooler) endpoint is fine for app runtime. SSL is required.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require

# Shared secret guarding POST /admin/sync. Must match the value set in the
# Render dashboard AND the GitHub Actions repo secret of the same name.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_AUTH_TOKEN=

# Your FPL Draft league id — the number in draft.premierleague.com/league/<ID>/...
FPL_DRAFT_LEAGUE_ID=

# Signs the commissioner session cookie for the UI login. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional: commissioner UI login password. If unset, login accepts SYNC_AUTH_TOKEN.
# ADMIN_PASSWORD=

# Optional: environment label. Set to "test" (e.g. when DATABASE_URL points at a
# Neon test branch) to show a TEST banner across the site. Defaults to "prod".
# APP_ENV=test

# Optional: overrides the FPL Draft API base (defaults to the public endpoint).
# FPL_API_BASE=https://draft.premierleague.com/api

# Optional: Discord outbound. Both are INCOMING WEBHOOK URLs (Channel Settings ->
# Integrations -> Webhooks) — no bot, no Developer Portal app, no privileged intent
# and no Manage Server permission needed. The URL is the whole credential, so treat
# it like a password. Each feature is OFF when its variable is unset.
#
# Public channel: announces every new trade once (site-entered and FPL-synced).
# DISCORD_WEBHOOK_URL=
#
# Private commissioner channel: flagged actions + failed health checks. Keep this
# pointed somewhere only you can read — it names managers and their infractions.
# DISCORD_ALERT_WEBHOOK_URL=

# Optional: Discord INBOUND (reading #trades and the IL channel). Needs a real bot,
# unlike the webhooks above. One-time setup, all by the server owner:
#   1. Developer Portal -> New Application -> Bot -> copy the token
#   2. Bot -> enable the MESSAGE CONTENT intent. It gates the REST API too, not just
#      the gateway: without it `content` comes back as an empty string and the request
#      still succeeds. Free to enable below 10,000 users — no review, no verification.
#   3. Invite it (needs Manage Server on the guild):
#      https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=68608
#      (68608 = View Channel + Send Messages + Read Message History)
#   4. If a channel is private, give the bot's role an explicit permission overwrite
#      on it — guild-level roles do NOT reach a channel hidden from @everyone, and a
#      missing Read Message History returns an EMPTY ARRAY rather than a 403, so it
#      looks exactly like a quiet channel. /admin/health probes for both.
# Channel ids: right-click a channel -> Copy Channel ID (needs Developer Mode on).
# DISCORD_BOT_TOKEN=
# DISCORD_TRADE_CHANNEL_ID=
# DISCORD_IL_CHANNEL_ID=
